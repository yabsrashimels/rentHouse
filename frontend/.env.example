# EthioRent Frontend Environment Variables
# Copy this file to .env and fill in your values

# API URL - in development, Vite proxy handles /api -> localhost:5000
# In production, set this to your backend URL
VITE_API_URL=http://localhost:5000/api

# App title (optional override)
VITE_APP_NAME=EthioRent

# Google Maps API key (optional - for property location map)
VITE_GOOGLE_MAPS_KEY=your-google-maps-key-here

# Cloudinary cloud name (for direct uploads if used)
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
