// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  TENANT
  OWNER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DEACTIVATED
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  STUDIO
  CONDO
  ROOM
  COMMERCIAL
  LAND
}

enum ListingStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_UNDER_REVIEW
  AWAITING_MODERATION
  PUBLISHED
  REJECTED
  EXPIRED
  RENTED
  SUSPENDED
}

enum PaymentMethod {
  TELEBIRR
  CBE
  DASHEN_BANK
  AWASH_BANK
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  CANCELLED
  REFUNDED
}

enum RentalRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ReportReason {
  FAKE_PROPERTY
  INCORRECT_PRICE
  MISLEADING_PHOTOS
  DUPLICATE_LISTING
  SUSPICIOUS_OWNER
  UNAVAILABLE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_PUBLISHED
  LISTING_EXPIRING_SOON
  LISTING_EXPIRED
  LISTING_RENEWED
  RENTAL_REQUEST_RECEIVED
  RENTAL_REQUEST_UPDATED
  SYSTEM_MESSAGE
}

enum VisibilityLevel {
  STANDARD
  ENHANCED
  FEATURED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id                  String        @id @default(cuid())
  fullName            String
  email               String        @unique
  phone               String
  passwordHash        String
  role                UserRole      @default(TENANT)
  telegram            String?
  instagram           String?
  profileImageUrl     String?
  accountStatus       AccountStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  properties          Property[]
  rentalRequests      RentalRequest[]   @relation("RentalRequester")
  payments            Payment[]
  verifiedPayments    Payment[]         @relation("PaymentVerifier")
  favorites           Favorite[]
  reports             ListingReport[]   @relation("Reporter")
  reviewedReports     ListingReport[]   @relation("ReviewedBy")
  notifications       Notification[]
  passwordResets      PasswordReset[]
  auditLogs           AuditLog[]        @relation("Actor")
  adminAuditLogs      AuditLog[]        @relation("AdminAuditLogs")
  sessions            UserSession[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([accountStatus])
}

model Property {
  id                    String         @id @default(cuid())
  ownerId               String
  title                 String
  slug                  String         @unique
  description           String
  propertyType          PropertyType
  monthlyRent           Decimal        @db.Decimal(12, 2)
  contactPhone          String
  bedrooms              Int
  bathrooms             Int
  sizeSquareMeters      Decimal?       @db.Decimal(10, 2)
  furnished             Boolean        @default(false)
  parkingAvailable      Boolean        @default(false)
  waterAvailable        Boolean        @default(true)
  electricityAvailable  Boolean        @default(true)
  amenities             String[]       @default([])
  region                String
  city                  String
  neighborhood          String?
  address               String?
  approximateLatitude   Decimal?       @db.Decimal(10, 8)
  approximateLongitude  Decimal?       @db.Decimal(11, 8)
  publicAddressEnabled  Boolean        @default(false)
  listingStatus         ListingStatus  @default(DRAFT)
  featuredUntil         DateTime?
  publishedAt           DateTime?
  expiresAt             DateTime?
  viewCount             Int            @default(0)
  contactRevealCount    Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  owner                 User           @relation(fields: [ownerId], references: [id])
  images                PropertyImage[]
  payments              Payment[]
  rentalRequests        RentalRequest[]
  favorites             Favorite[]
  reports               ListingReport[]

  @@index([ownerId])
  @@index([listingStatus])
  @@index([city])
  @@index([region])
  @@index([monthlyRent])
  @@index([bedrooms])
  @@index([propertyType])
  @@index([featuredUntil])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([slug])
}

model PropertyImage {
  id           String   @id @default(cuid())
  propertyId   String
  imageUrl     String
  storageKey   String
  displayOrder Int      @default(0)
  isCover      Boolean  @default(false)
  altText      String?
  createdAt    DateTime @default(now())

  // Relations
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model ListingPackage {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  description        String?
  priceInETB         Decimal         @db.Decimal(10, 2)
  durationDays       Int
  maximumPhotos      Int
  featuredPlacement  Boolean         @default(false)
  visibilityLevel    VisibilityLevel @default(STANDARD)
  sortOrder          Int             @default(0)
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relations
  payments           Payment[]

  @@index([active])
  @@index([slug])
}

model Payment {
  id                   String        @id @default(cuid())
  userId               String
  propertyId           String
  packageId            String
  amountInETB          Decimal       @db.Decimal(10, 2)
  paymentMethod        PaymentMethod?
  transactionReference String?
  receiptUrl           String?
  receiptStorageKey    String?
  paymentStatus        PaymentStatus @default(PENDING)
  verifiedById         String?
  verifiedAt           DateTime?
  rejectionReason      String?
  notes                String?
  ipAddress            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relations
  user                 User          @relation(fields: [userId], references: [id])
  property             Property      @relation(fields: [propertyId], references: [id])
  package              ListingPackage @relation(fields: [packageId], references: [id])
  verifiedBy           User?         @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  verificationHistory  PaymentVerificationHistory[]

  @@index([userId])
  @@index([propertyId])
  @@index([paymentStatus])
  @@index([packageId])
  @@index([verifiedById])
}

model PaymentVerificationHistory {
  id          String        @id @default(cuid())
  paymentId   String
  adminId     String
  action      String
  reason      String?
  createdAt   DateTime      @default(now())

  // Relations
  payment     Payment       @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model RentalRequest {
  id              String              @id @default(cuid())
  propertyId      String
  renterId        String
  message         String
  status          RentalRequestStatus @default(PENDING)
  responseMessage String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  renter          User                @relation("RentalRequester", fields: [renterId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([renterId, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model ListingReport {
  id          String       @id @default(cuid())
  propertyId  String
  reporterId  String?
  reason      ReportReason
  description String?
  reportStatus ReportStatus @default(OPEN)
  reviewedById String?
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime     @default(now())

  // Relations
  property    Property     @relation(fields: [propertyId], references: [id])
  reporter    User?        @relation("Reporter", fields: [reporterId], references: [id])
  reviewedBy  User?        @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([propertyId])
  @@index([reporterId])
  @@index([reportStatus])
}

model AuditLog {
  id               String   @id @default(cuid())
  actorId          String?
  adminId          String?
  action           String
  entityType       String
  entityId         String?
  relevantMetadata Json?
  ipAddress        String?
  createdAt        DateTime @default(now())

  // Relations
  actor            User?    @relation("Actor", fields: [actorId], references: [id])
  admin            User?    @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([actorId])
  @@index([adminId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  data       Json?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  // Relations
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
